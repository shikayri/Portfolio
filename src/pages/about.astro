    function toggleTheme() {
      const body = document.body;
      const themeToggle = document.querySelector('.theme-toggle');
      const isDark = body.getAttribute('data-theme') === 'dark';
      const newTheme = isDark ? 'light' : 'dark';
      body.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      themeToggle.classList.add('animating');
      setTimeout(() => themeToggle.classList.remove('animating'), 500);
    }

    function toggleLanguage() {
      const body = document.body;
      const currentLang = body.getAttribute('data-lang') || 'en';
      const newLang = currentLang === 'en' ? 'id' : 'en';
      body.setAttribute('data-lang', newLang);
      localStorage.setItem('lang', newLang);
      updateLanguage(newLang);
    }

    function updateLanguage(lang) {
      const t = translations[lang];
      // Update navigation
      document.querySelector('a[href="/Portfolio/"]').textContent = t.home;
      document.querySelector('a[href="#about"]').textContent = t.about;
      document.querySelector('a[href="#personal"]').textContent = t.personalLife;
      document.querySelector('a[href="#blog"]').textContent = t.blog;
      document.querySelector('a[href="/Portfolio/#contact"]').textContent = t.contact;

      // Update sections
      document.querySelector('#about h2').textContent = t.aboutMe;
      document.querySelector('#about p').textContent = t.aboutText;
      document.querySelector('#personal h2').textContent = t.personalLife;
      document.querySelector('#blog h2').textContent = t.blog;
      document.querySelector('#blog p').textContent = t.blogDescription;

      // Update personal section
      const personalCards = document.querySelectorAll('#personal .card');
      if (personalCards[0]) personalCards[0].querySelector('h3').textContent = t.hobbies;
      if (personalCards[1]) personalCards[1].querySelector('h3').textContent = t.interests;
      if (personalCards[2]) personalCards[2].querySelector('h3').textContent = t.personalProjects;

      // Update hobbies
      const hobbiesLis = document.querySelectorAll('#personal .card:nth-child(1) ul li');
      if (hobbiesLis[0]) hobbiesLis[0].textContent = t.gaming;
      if (hobbiesLis[1]) hobbiesLis[1].textContent = t.readingTechBlogs;
      if (hobbiesLis[2]) hobbiesLis[2].textContent = t.photography;
      if (hobbiesLis[3]) hobbiesLis[3].textContent = t.music;

      // Update interests
      const interestsLis = document.querySelectorAll('#personal .card:nth-child(2) ul li');
      if (interestsLis[0]) interestsLis[0].textContent = t.artificialIntelligence;
      if (interestsLis[1]) interestsLis[1].textContent = t.cybersecurity;
      if (interestsLis[2]) interestsLis[2].textContent = t.openSourceProjects;
      if (interestsLis[3]) interestsLis[3].textContent = t.uiUxDesign;

      // Update personal projects
      const projectsLis = document.querySelectorAll('#personal .card:nth-child(3) ul li');
      if (projectsLis[0]) projectsLis[0].textContent = t.personalWebsiteDevelopment;
      if (projectsLis[1]) projectsLis[1].textContent = t.videoEditingTutorials;
      if (projectsLis[2]) projectsLis[2].textContent = t.graphicDesignPortfolios;
      if (projectsLis[3]) projectsLis[3].textContent = t.learningNewProgrammingLanguages;

      // Update blog posts
      const blogCards = document.querySelectorAll('#blog .card');
      if (blogCards[0]) {
        blogCards[0].querySelector('h3').textContent = t.gettingStartedWithWebDevelopment;
        blogCards[0].querySelector('p').textContent = t.gettingStartedText;
      }
      if (blogCards[1]) {
        blogCards[1].querySelector('h3').textContent = t.whyILoveLaravel;
        blogCards[1].querySelector('p').textContent = t.laravelText;
      }
      if (blogCards[2]) {
        blogCards[2].querySelector('h3').textContent = t.balancingCodeAndLife;
        blogCards[2].querySelector('p').textContent = t.balancingText;
      }

      // Update footer
      document.querySelector('footer p').innerHTML = t.copyright;
      document.querySelector('footer a').textContent = t.backToTop;
    }

    function toggleMenu() {
      document.getElementById('nav-menu').classList.toggle('show');
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Scroll to top on page refresh
      window.scrollTo(0, 0);

      const savedTheme = localStorage.getItem('theme') || 'light';
      document.body.setAttribute('data-theme', savedTheme);

      const savedLang = localStorage.getItem('lang') || 'en';
      document.body.setAttribute('data-lang', savedLang);
      updateLanguage(savedLang);

      const elements = document.querySelectorAll('.animate');
      const checkVisibility = () => {
        elements.forEach(el => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('visible');
          }
        });
      };
      window.addEventListener('scroll', checkVisibility);

      // Prevent right-click on logo to disable download via context menu
      const logo = document.querySelector('.logo');
      if (logo) {
        logo.addEventListener('contextmenu', (e) => {
          e.preventDefault();
        });
        logo.oncontextmenu = () => false;
      }
    });
  </script>
</body>
</html>
